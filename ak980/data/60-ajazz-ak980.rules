# Ajazz AK980 V2: lets the logged-in user (and the "input" group) use the keyboard's
# configuration interfaces without root. 0c45:8009 is the USB cable, 0c45:fefe the 2.4 GHz dongle.
# Installed by ajazz-ak980-v2-linux (https://github.com/yellowhearth1/ajazz-ak980-v2-linux).
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8009", MODE="0660", GROUP="input", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="fefe", MODE="0660", GROUP="input", TAG+="uaccess"
