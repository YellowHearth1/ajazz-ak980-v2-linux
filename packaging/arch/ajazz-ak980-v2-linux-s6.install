# The service leaves the default bundle before its definition goes: s6-rc compiles every service
# at once, and a bundle naming one that is gone would stop every later change from compiling.
# Nothing here may fail the transaction.

pre_remove() {
  if [ -e /etc/s6/adminsv/default/contents.d/ak980d-srv ]; then
    s6-service delete default ak980d-srv >/dev/null 2>&1 && s6-db-reload >/dev/null 2>&1
  fi
  true
}
