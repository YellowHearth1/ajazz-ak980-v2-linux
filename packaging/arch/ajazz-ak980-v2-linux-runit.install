# The service's link goes before its directory, so runsvdir does not keep trying a directory that
# is gone. Nothing here may fail the transaction.

pre_remove() {
  for link in /run/runit/service/ak980d /etc/runit/runsvdir/*/ak980d /var/service/ak980d; do
    if [ -L "$link" ]; then
      rm -f "$link"
    fi
  done
  true
}
