pkgbase = ajazz-ak980-v2-linux
	pkgdesc = Ajazz AK980 V2 | Software for Linux: screen clock and GIFs, lighting, PC lighting effects, keys, macros, profiles
	pkgver = 0.0.2
	pkgrel = 1
	url = https://github.com/yellowhearth1/ajazz-ak980-v2-linux
	arch = x86_64
	arch = aarch64
	license = MIT
	license = Ubuntu-font-1.0
	makedepends = cargo
	source = ajazz-ak980-v2-linux-0.0.2.tar.gz::https://github.com/yellowhearth1/ajazz-ak980-v2-linux/archive/refs/tags/v0.0.2.tar.gz
	sha256sums = SKIP

pkgname = ajazz-ak980-v2-linux
	install = ajazz-ak980-v2-linux.install
	depends = gcc-libs
	depends = glibc
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxi
	depends = libxrandr
	depends = vulkan-icd-loader
	optdepends = libpulse: music lighting effects through parec
	optdepends = pipewire: music lighting effects through pw-record
	optdepends = polkit: allow keyboard access, reconnect the receiver and set up system services from the app
	optdepends = libnotify: notifications from the background agent (low battery, lost 2.4 GHz link)
	optdepends = xdg-desktop-portal: file dialogs of the desktop
	backup = etc/ak980/agent.conf

pkgname = ajazz-ak980-v2-linux-openrc
	pkgdesc = OpenRC service for Ajazz AK980 V2 | Software for Linux (screen clock)
	install = ajazz-ak980-v2-linux-openrc.install
	depends = ajazz-ak980-v2-linux
	depends = openrc

pkgname = ajazz-ak980-v2-linux-dinit
	pkgdesc = dinit services for Ajazz AK980 V2 | Software for Linux (system clock service and user agent)
	install = ajazz-ak980-v2-linux-dinit.install
	depends = ajazz-ak980-v2-linux
	depends = dinit

pkgname = ajazz-ak980-v2-linux-runit
	pkgdesc = runit service for Ajazz AK980 V2 | Software for Linux (screen clock)
	install = ajazz-ak980-v2-linux-runit.install
	depends = ajazz-ak980-v2-linux
	depends = runit

pkgname = ajazz-ak980-v2-linux-s6
	pkgdesc = s6 service for Ajazz AK980 V2 | Software for Linux (screen clock)
	install = ajazz-ak980-v2-linux-s6.install
	depends = ajazz-ak980-v2-linux
	depends = s6
