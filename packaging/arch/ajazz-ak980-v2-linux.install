# The udev rule takes effect through pacman's own udev hook, which reloads the rules after the
# transaction; nothing here has to trigger devices.

post_install() {
  cat <<'MSG'
==> Ajazz AK980 V2: if the app still cannot reach the keyboard, reconnect it.
==> The background agent starts with your desktop session. To start it as a service instead:
      systemd:  systemctl --user enable --now ak980-agent.service
      dinit:    dinitctl --user enable ak980-agent     (package ajazz-ak980-v2-linux-dinit)
    Clock only, system-wide (before login too):
      systemd:  systemctl enable --now ak980d.service
      OpenRC:   rc-update add ak980d default && rc-service ak980d start
      dinit:    dinitctl enable ak980d
      runit:    ln -s /etc/runit/sv/ak980d /run/runit/service/
      s6:       s6-service add default ak980d-srv && s6-db-reload
    Or pick one on the app's Device page.
MSG
}

# The system-wide clock service is switched off before its unit goes; on other init systems there
# is no systemctl and nothing to do. Nothing here may fail the transaction.
pre_remove() {
  systemctl disable --now ak980d.service >/dev/null 2>&1 || true
}
